APP_NAME=Candidate Automation - Marathi Document Generator
APP_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:8000
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_URL=sqlite:///./candidate_registration.db
SESSION_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=generate-with-python-Fernet.generate_key
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
GOOGLE_CLOUD_PROJECT=Candidate Automation
GOOGLE_APPLICATION_CREDENTIALS=
TRANSLATION_MOCK=true
POLLING_INTERVAL_SECONDS=120
MAX_UPLOAD_BYTES=15728640
TEMPLATE_PATH=app/templates/candidate_template.docx
